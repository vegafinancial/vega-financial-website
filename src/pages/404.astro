---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you are looking for does not exist or has moved.">
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-6xl font-bold text-vega-navy mb-4">404</h1>
      <h2 class="text-3xl font-bold text-vega-navy mb-8">Page not found</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed mb-8">
        The page you're looking for doesn't exist or may have moved.
      </p>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        <a href="/">Return to the homepage</a> or visit our
        <a href="/services/">Services</a>, <a href="/engagement/">Engagement</a>, or
        <a href="/contact/">Contact</a> pages.
      </p>
    </div>
  </section>
</Layout>
