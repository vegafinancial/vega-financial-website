---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="Learn about Vega Financial's mission and team">
  <section class="bg-vega-light py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-5xl font-bold text-vega-navy mb-8">About Vega Financial</h1>
      <div class="grid grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl font-bold text-vega-navy mb-4">Our Mission</h2>
          <p class="text-gray-600 mb-4">
            At Vega Financial, we are committed to providing expert financial advice and personalized planning services to help our clients achieve their financial goals.
          </p>
          <p class="text-gray-600">
            With years of experience in the financial services industry, our team is dedicated to delivering comprehensive solutions tailored to your unique needs.
          </p>
        </div>
        <div>
          <h2 class="text-3xl font-bold text-vega-navy mb-4">Our Values</h2>
          <ul class="space-y-3 text-gray-600">
            <li class="flex items-start">
              <span class="text-vega-gold mr-3">✓</span>
              <span>Integrity and transparency in all dealings</span>
            </li>
            <li class="flex items-start">
              <span class="text-vega-gold mr-3">✓</span>
              <span>Client-focused approach to financial planning</span>
            </li>
            <li class="flex items-start">
              <span class="text-vega-gold mr-3">✓</span>
              <span>Continuous education and professional development</span>
            </li>
            <li class="flex items-start">
              <span class="text-vega-gold mr-3">✓</span>
              <span>Long-term relationships with our clients</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
