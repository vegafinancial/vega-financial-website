---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Vega Financial">
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-5xl font-bold text-vega-navy mb-8 text-center">Contact Us</h1>
      <p class="text-xl text-gray-600 text-center mb-12">
        We'd love to hear from you. Get in touch with us today.
      </p>

      <div class="grid grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold text-vega-navy mb-6">Contact Information</h2>
          <div class="space-y-6">
            <div>
              <h3 class="font-bold text-vega-navy mb-2">Email</h3>
              <p class="text-gray-600">hello@vegafinancial.com</p>
            </div>
            <div>
              <h3 class="font-bold text-vega-navy mb-2">Phone</h3>
              <p class="text-gray-600">(555) 123-4567</p>
            </div>
            <div>
              <h3 class="font-bold text-vega-navy mb-2">Address</h3>
              <p class="text-gray-600">
                123 Financial Street<br />
                New York, NY 10001<br />
                United States
              </p>
            </div>
            <div>
              <h3 class="font-bold text-vega-navy mb-2">Hours</h3>
              <p class="text-gray-600">
                Monday - Friday: 9:00 AM - 5:00 PM<br />
                Saturday - Sunday: Closed
              </p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-vega-navy mb-6">Send us a Message</h2>
          <form class="space-y-4">
            <div>
              <label for="name" class="block text-sm font-bold text-vega-navy mb-2">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-vega-gold"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-bold text-vega-navy mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-vega-gold"
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-bold text-vega-navy mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-vega-gold"
              ></textarea>
            </div>
            <button
              type="submit"
              class="bg-vega-gold text-vega-navy px-8 py-3 rounded font-bold hover:opacity-90 transition w-full"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
