---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Vega Financial - Helping families build wealth through comprehensive financial solutions">
  <!-- Hero Section -->
  <section class="bg-gradient-to-b text-white py-32">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-6xl font-bold mb-4 leading-tight">Helping families build wealth.</h1>
      <p class="text-2xl mb-8 text-blue-100">Comprehensive Financial Solutions</p>
      <p class="text-lg mb-8 text-gray-300 max-w-2xl mx-auto">Expert guidance for wealth creation, retirement security, and long-term financial success.</p>
      <a href="https://scheduler.zoom.us/tyson-farmer/start-your-financial-journey-with-vega" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Schedule Your Free Introductory Call
      </a>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl font-bold text-vega-navy mb-4 text-center">Our Services</h2>
      <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">Comprehensive financial solutions designed to help you achieve your goals</p>

      <div class="grid grid-cols-3">
        <div class="card">
          <div class="card-icon"></div>
          <h3 class="text-xl font-bold text-vega-navy mb-3">Financial Planning</h3>
          <p class="text-gray-600">Comprehensive planning tailored to your unique goals, lifestyle, and values.</p>
        </div>
        <div class="card">
          <div class="card-icon"></div>
          <h3 class="text-xl font-bold text-vega-navy mb-3">Investment Management</h3>
          <p class="text-gray-600">Professional strategies designed for growth, diversification, and risk management.</p>
        </div>
        <div class="card">
          <div class="card-icon"></div>
          <h3 class="text-xl font-bold text-vega-navy mb-3">Retirement Planning</h3>
          <p class="text-gray-600">Strategic planning to ensure financial security and a comfortable retirement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-gradient-to-r text-white py-16">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Work Together?</h2>
      <p class="text-lg mb-8 text-blue-100">Let's discuss your financial goals and create a personalized plan for success.</p>
      <a href="https://scheduler.zoom.us/tyson-farmer/start-your-financial-journey-with-vega" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Schedule a Free Consultation
      </a>
    </div>
  </section>
</Layout>
