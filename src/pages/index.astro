---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Vega Financial - Professional Financial Advisory Services">
  <section class="bg-vega-light py-20">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold text-vega-navy mb-4">Welcome to Vega Financial</h1>
      <p class="text-xl text-gray-600 mb-8">Expert financial planning and advisory services for your future.</p>
      <a href="/contact/" class="bg-vega-gold text-vega-navy px-8 py-3 rounded font-bold hover:opacity-90 transition">
        Get Started
      </a>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-vega-navy mb-12 text-center">Our Services</h2>
      <div class="grid grid-cols-3 gap-8">
        <div class="p-6 bg-vega-light rounded">
          <h3 class="text-xl font-bold text-vega-navy mb-3">Financial Planning</h3>
          <p class="text-gray-600">Comprehensive financial planning tailored to your goals and lifestyle.</p>
        </div>
        <div class="p-6 bg-vega-light rounded">
          <h3 class="text-xl font-bold text-vega-navy mb-3">Investment Management</h3>
          <p class="text-gray-600">Professional investment strategies designed for long-term growth.</p>
        </div>
        <div class="p-6 bg-vega-light rounded">
          <h3 class="text-xl font-bold text-vega-navy mb-3">Retirement Planning</h3>
          <p class="text-gray-600">Strategic retirement planning to ensure financial security.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
