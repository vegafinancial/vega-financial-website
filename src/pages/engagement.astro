---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Engagement" description="How we work with you - Our proven financial planning process">
  <!-- Hero -->
  <section class="bg-gradient-to-b from-vega-navy to-blue-900 text-white py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-5xl font-bold mb-4">Our Engagement Process</h1>
      <p class="text-xl text-blue-100">A structured approach to understanding your needs and building lasting wealth</p>
    </div>
  </section>

  <!-- Process Steps -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-4 gap-6 mb-16">
        <div class="text-center">
          <div class="bg-vega-navy text-white rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4 text-3xl font-bold">1</div>
          <h3 class="font-bold text-vega-navy mb-2 text-lg">Discovery</h3>
          <p class="text-gray-600 text-sm">Understand your goals, values, and financial situation</p>
        </div>
        <div class="text-center">
          <div class="bg-vega-navy text-white rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4 text-3xl font-bold">2</div>
          <h3 class="font-bold text-vega-navy mb-2 text-lg">Analysis</h3>
          <p class="text-gray-600 text-sm">Comprehensive analysis of your financial picture</p>
        </div>
        <div class="text-center">
          <div class="bg-vega-navy text-white rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4 text-3xl font-bold">3</div>
          <h3 class="font-bold text-vega-navy mb-2 text-lg">Strategy</h3>
          <p class="text-gray-600 text-sm">Develop personalized financial plan and recommendations</p>
        </div>
        <div class="text-center">
          <div class="bg-vega-navy text-white rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4 text-3xl font-bold">4</div>
          <h3 class="font-bold text-vega-navy mb-2 text-lg">Implementation</h3>
          <p class="text-gray-600 text-sm">Execute plan with ongoing monitoring and support</p>
        </div>
      </div>

      <div class="faq-card mb-16">
        <h2 class="text-3xl font-bold text-vega-navy mb-6 text-center">Frequently Asked Questions</h2>

        <div class="faq-list">
          <div class="faq-item">
            <h3 class="font-bold text-vega-navy mb-2">Is the first consultation really free?</h3>
            <p class="text-gray-600">Yes. Our initial consultation is completely free. We use this time to understand your situation and discuss how we might be able to help.</p>
          </div>
          <div class="faq-item">
            <h3 class="font-bold text-vega-navy mb-2">How long does the planning process take?</h3>
            <p class="text-gray-600">The timeline varies based on your situation's complexity. Most comprehensive plans are completed within 4-8 weeks.</p>
          </div>
          <div class="faq-item">
            <h3 class="font-bold text-vega-navy mb-2">What are your service fees?</h3>
            <p class="text-gray-600">We offer transparent, straightforward fee structures. We'll discuss all fees during your initial consultation.</p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <h2 class="text-3xl font-bold text-vega-navy mb-4">Ready to Schedule Your Free Consultation?</h2>
        <p class="text-gray-600 mb-8 max-w-2xl mx-auto">
          Let's start your financial journey with a conversation. Click below to select a time that works for you.
        </p>
        <a href="https://scheduler.zoom.us/tyson-farmer/start-your-financial-journey-with-vega" target="_blank" rel="noopener noreferrer" class="inline-block bg-vega-navy text-white px-8 py-3 rounded font-bold hover:bg-blue-900 transition">
          Schedule Your Free Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
