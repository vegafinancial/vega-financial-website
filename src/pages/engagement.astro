---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Engagement" description="How to work with Vega Financial">
  <section class="bg-vega-light py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-5xl font-bold text-vega-navy mb-8 text-center">Our Engagement Process</h1>
      <p class="text-xl text-gray-600 text-center mb-12">
        We follow a structured process to understand your needs and deliver tailored solutions.
      </p>

      <div class="grid grid-cols-4 gap-8 mb-12">
        <div class="text-center">
          <div class="bg-vega-gold text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4 text-2xl font-bold">1</div>
          <h3 class="font-bold text-vega-navy mb-2">Discovery</h3>
          <p class="text-gray-600">Understand your goals and financial situation</p>
        </div>
        <div class="text-center">
          <div class="bg-vega-gold text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4 text-2xl font-bold">2</div>
          <h3 class="font-bold text-vega-navy mb-2">Analysis</h3>
          <p class="text-gray-600">Analyze your current financial position</p>
        </div>
        <div class="text-center">
          <div class="bg-vega-gold text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4 text-2xl font-bold">3</div>
          <h3 class="font-bold text-vega-navy mb-2">Planning</h3>
          <p class="text-gray-600">Develop a comprehensive financial plan</p>
        </div>
        <div class="text-center">
          <div class="bg-vega-gold text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4 text-2xl font-bold">4</div>
          <h3 class="font-bold text-vega-navy mb-2">Implementation</h3>
          <p class="text-gray-600">Execute the plan and monitor progress</p>
        </div>
      </div>

      <div class="text-center">
        <h2 class="text-3xl font-bold text-vega-navy mb-6">Ready to Get Started?</h2>
        <p class="text-gray-600 mb-8 max-w-2xl mx-auto">
          Schedule a free consultation with one of our financial advisors to discuss your goals and learn how we can help.
        </p>
        <a href="/contact/" class="bg-vega-gold text-vega-navy px-8 py-3 rounded font-bold hover:opacity-90 transition inline-block">
          Book Your Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
