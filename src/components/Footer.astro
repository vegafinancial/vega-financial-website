---
const currentYear = new Date().getFullYear();
---

<footer class="bg-vega-dark text-white mt-16">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="text-vega-gold font-bold mb-4">Vega Financial</h3>
        <p class="text-gray-300">Professional financial advisory services.</p>
      </div>
      <div>
        <h4 class="text-vega-gold font-bold mb-4">Quick Links</h4>
        <ul class="space-y-2 text-gray-300">
          <li><a href="/" class="hover:text-vega-gold transition">Home</a></li>
          <li><a href="/about/" class="hover:text-vega-gold transition">About</a></li>
          <li><a href="/services/" class="hover:text-vega-gold transition">Services</a></li>
          <li><a href="/contact/" class="hover:text-vega-gold transition">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-vega-gold font-bold mb-4">Contact</h4>
        <p class="text-gray-300">Email: hello@vegafinancial.com</p>
        <p class="text-gray-300">Phone: (555) 123-4567</p>
      </div>
    </div>
    <div class="border-t border-gray-700 pt-8 text-center text-gray-400">
      <p>&copy; {currentYear} Vega Financial. All rights reserved.</p>
    </div>
  </div>
</footer>
