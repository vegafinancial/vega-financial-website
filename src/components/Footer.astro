  <!-- Redirect disclaimer modal (Schwab / Orion) -->
  <div id="redirectModal" class="redirect-modal" role="dialog" aria-modal="true" aria-labelledby="redirectTitle" aria-describedby="redirectIntro" hidden>
    <div class="redirect-backdrop" data-close></div>
    <div class="redirect-dialog">
      <h2 id="redirectTitle">Important Notice</h2>
      <p id="redirectIntro" class="redirect-intro"></p>
      <div class="redirect-actions">
        <a id="redirectContinue" class="redirect-btn redirect-continue" href="#" target="_blank" rel="noopener noreferrer">Continue</a>
        <button type="button" class="redirect-btn redirect-cancel" data-close>Cancel</button>
      </div>
      <button type="button" id="redirectToggle" class="redirect-toggle" aria-expanded="false" aria-controls="redirectFull">View Full Disclaimer</button>
      <div id="redirectFull" class="redirect-full" hidden></div>
    </div>
  </div>
</footer>

<style>
  .redirect-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .redirect-modal[hidden] { display: none; }
  .redirect-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 17, 40, 0.55);
    backdrop-filter: blur(2px);
  }
  .redirect-dialog {
    position: relative;
    background: var(--white, #fff);
    color: #1f2430;
    max-width: 540px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    border-radius: 16px;
    padding: 2.25rem 2.25rem 2rem;
    box-shadow: 0 24px 60px -16px rgba(20, 25, 60, 0.45);
  }
  .redirect-dialog h2 {
    margin: 0 0 1rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy, #262261);
  }
  .redirect-intro {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #3d4350;
  }
  .redirect-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .redirect-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.6rem;
    border-radius: 9999px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid transparent;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .redirect-continue {
    background: var(--navy, #262261);
    color: #fff;
  }
  .redirect-continue:hover { background: var(--navy-light, #3a3594); }
  .redirect-cancel {
    background: transparent;
    color: var(--navy, #262261);
    border-color: #cfd5e2;
  }
  .redirect-cancel:hover { background: #f1f3f9; }
  .redirect-toggle {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0;
    background: none;
    border: none;
    color: var(--navy-light, #3a3594);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
  }
  .redirect-full {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e6e9f0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #4a5160;
  }
  .redirect-full p { margin: 0 0 0.85rem; }
  .redirect-full p:last-child { margin-bottom: 0; }
</style>

<script is:inline>
  (function () {
    var DISCLAIMERS = {
      schwab: {
        name: 'Charles Schwab',
        intro:
          'You are about to leave the Vega Financial website and be redirected to the Charles Schwab & Co., Inc. (“Schwab”) website. Schwab is unaffiliated with Vega Financial LLC. Their privacy and security policies may differ.',
        full: [
          'You are now leaving the Vega Financial website and will be directed to the Charles Schwab & Co., Inc. (“Schwab”) website. Schwab is a registered broker-dealer and is not affiliated with Vega Financial LLC.',
          'Vega Financial LLC is independently owned and operated and does not control, guarantee, or endorse any information, products, or services provided on Schwab’s website. The information and services available at Schwab are provided solely by Schwab and are subject to its terms, conditions, privacy, and security policies, which may differ from those of Vega Financial LLC.',
          'By proceeding, you acknowledge that you understand you are leaving the Vega Financial website and that Vega Financial is not responsible for the content, accuracy, or availability of information on Schwab’s website.',
          'If you do not wish to continue, you may return to the Vega Financial website.',
        ],
      },
      orion: {
        name: 'Orion',
        intro:
          'You are about to leave the Vega Financial website and be redirected to the Orion Advisor Technology, LLC (“Orion”) client portal. Orion is unaffiliated with Vega Financial LLC. Their privacy and security policies may differ.',
        full: [
          'You are now leaving the Vega Financial website and will be directed to the Orion Advisor Technology, LLC (“Orion”) client portal. Orion provides portfolio reporting and account access technology and is not affiliated with Vega Financial LLC.',
          'Vega Financial LLC is independently owned and operated and does not control, guarantee, or endorse any information, products, or services provided on Orion’s website. The information and services available through Orion are provided solely by Orion and are subject to its terms, conditions, privacy, and security policies, which may differ from those of Vega Financial LLC.',
          'By proceeding, you acknowledge that you understand you are leaving the Vega Financial website and that Vega Financial is not responsible for the content, accuracy, or availability of information on Orion’s website.',
          'If you do not wish to continue, you may return to the Vega Financial website.',
        ],
      },
    };

    var modal = document.getElementById('redirectModal');
    if (!modal) return;
    var intro = document.getElementById('redirectIntro');
    var cont = document.getElementById('redirectContinue');
    var toggle = document.getElementById('redirectToggle');
    var full = document.getElementById('redirectFull');
    var lastFocused = null;

    function openModal(key, url) {
      var d = DISCLAIMERS[key];
      if (!d) return;
      intro.textContent = d.intro;
      cont.href = url;
      full.innerHTML = '';
      d.full.forEach(function (para) {
        var p = document.createElement('p');
        p.textContent = para;
        full.appendChild(p);
      });
      full.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.textContent = 'View Full Disclaimer';
      lastFocused = document.activeElement;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      cont.focus();
    }

    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    document.querySelectorAll('a[data-redirect]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        openModal(link.getAttribute('data-redirect'), link.href);
      });
    });

    modal.querySelectorAll('[data-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    cont.addEventListener('click', function () {
      // Let the browser open the link, then dismiss the modal.
      setTimeout(closeModal, 0);
    });

    toggle.addEventListener('click', function () {
      var expanded = full.hidden === false;
      full.hidden = expanded;
      toggle.setAttribute('aria-expanded', String(!expanded));
      toggle.textContent = expanded ? 'View Full Disclaimer' : 'Hide Full Disclaimer';
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
  })();
</script>
