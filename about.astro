---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="Learn about Vega Financial's mission, values, and expertise">
  <!-- Hero -->
  <section class="bg-gradient-to-b from-vega-navy to-blue-900 text-white py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-5xl font-bold mb-4">About Vega Financial</h1>
      <p class="text-xl text-blue-100">Expert guidance for building and protecting wealth</p>
    </div>
  </section>

  <!-- Mission & Values -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl font-bold text-vega-navy mb-6">Our Mission</h2>
          <p class="text-gray-600 mb-4 leading-relaxed">
            At Vega Financial, we empower families to build lasting wealth through expert financial guidance, personalized planning, and comprehensive solutions.
          </p>
          <p class="text-gray-600 leading-relaxed">
            We believe in taking a holistic approach to financial planning—understanding your values, goals, and circumstances to create strategies that truly align with your vision for the future.
          </p>
        </div>
        <div>
          <h2 class="text-3xl font-bold text-vega-navy mb-6">Our Values</h2>
          <ul class="space-y-4">
            <li class="flex items-start">
              <div class="w-6 h-6 bg-blue-400 rounded-full mr-4 mt-1 flex-shrink-0"></div>
              <span class="text-gray-600"><strong class="text-vega-navy">Integrity:</strong> Transparent, honest relationships built on trust</span>
            </li>
            <li class="flex items-start">
              <div class="w-6 h-6 bg-blue-400 rounded-full mr-4 mt-1 flex-shrink-0"></div>
              <span class="text-gray-600"><strong class="text-vega-navy">Excellence:</strong> Expert guidance backed by continuous learning</span>
            </li>
            <li class="flex items-start">
              <div class="w-6 h-6 bg-blue-400 rounded-full mr-4 mt-1 flex-shrink-0"></div>
              <span class="text-gray-600"><strong class="text-vega-navy">Client-Focused:</strong> Your goals drive our recommendations</span>
            </li>
            <li class="flex items-start">
              <div class="w-6 h-6 bg-blue-400 rounded-full mr-4 mt-1 flex-shrink-0"></div>
              <span class="text-gray-600"><strong class="text-vega-navy">Partnership:</strong> Long-term relationships built on mutual success</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-r from-vega-navy to-blue-900 text-white py-16">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Learn More?</h2>
      <a href="https://scheduler.zoom.us/tyson-farmer/start-your-financial-journey-with-vega" target="_blank" rel="noopener noreferrer" class="inline-block bg-blue-400 text-vega-navy px-8 py-3 rounded font-bold hover:bg-blue-300 transition">
        Schedule Your Free Consultation
      </a>
    </div>
  </section>
</Layout>
