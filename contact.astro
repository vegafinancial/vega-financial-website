---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Vega Financial">
  <!-- Hero -->
  <section class="bg-gradient-to-b from-vega-navy to-blue-900 text-white py-20">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-5xl font-bold mb-4">Contact Us</h1>
      <p class="text-xl text-blue-100">We're here to help. Get in touch today.</p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h2 class="text-3xl font-bold text-vega-navy mb-8">Get in Touch</h2>
          <div class="space-y-8">
            <div>
              <h3 class="font-bold text-vega-navy mb-2 text-lg">Email</h3>
              <p class="text-gray-600">
                <a href="mailto:info@vega-financial.com" class="hover:text-vega-navy">
                  info@vega-financial.com
                </a>
              </p>
            </div>
            <div>
              <h3 class="font-bold text-vega-navy mb-2 text-lg">Schedule a Call</h3>
              <p class="text-gray-600 mb-4">Book a free consultation directly:</p>
              <a href="https://scheduler.zoom.us/tyson-farmer/start-your-financial-journey-with-vega" target="_blank" rel="noopener noreferrer" class="inline-block bg-blue-400 text-vega-navy px-6 py-2 rounded font-bold hover:bg-blue-300 transition">
                Schedule Now
              </a>
            </div>
            <div>
              <h3 class="font-bold text-vega-navy mb-2 text-lg">Business Hours</h3>
              <p class="text-gray-600">
                Monday - Friday: 9:00 AM - 5:00 PM EST<br />
                Saturday - Sunday: Closed
              </p>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <h2 class="text-3xl font-bold text-vega-navy mb-8">Send us a Message</h2>
          <form action="https://formspree.io/f/xyzabc123" method="POST" class="space-y-4">
            <div>
              <label for="name" class="block text-sm font-bold text-vega-navy mb-2">Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-400"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-bold text-vega-navy mb-2">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-400"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-bold text-vega-navy mb-2">Phone</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-400"
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-bold text-vega-navy mb-2">Message *</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-400"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-vega-navy text-white px-8 py-3 rounded font-bold hover:bg-blue-900 transition"
            >
              Send Message
            </button>
          </form>
          <p class="text-sm text-gray-500 mt-4">We'll get back to you within 24 business hours.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
